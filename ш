<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Мессенджер</title>

<script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-firestore-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.8.1/firebase-storage-compat.js"></script>

<style>
  :root{
    --bg: #efeff4;
    --bg-elevated: #f7f7f7;
    --card: #ffffff;
    --blue: #007aff;
    --blue-grad-a: #3fa9f5;
    --blue-grad-b: #0a7cf5;
    --gray-bubble: #ffffff;
    --text: #000000;
    --sub: #8e8e93;
    --sep: rgba(60,60,67,0.29);
    --nav-blur: rgba(247,247,247,0.85);
    --tabbar-blur: rgba(247,247,247,0.88);
    --switch-off: #e9e9ea;
    --danger: #ff3b30;
    --success: #34c759;
    --warning: #ff9500;
  }
  html.dark{
    --bg: #000000;
    --bg-elevated: #1c1c1e;
    --card: #1c1c1e;
    --gray-bubble: #262628;
    --text: #ffffff;
    --sub: #8e8e93;
    --sep: rgba(84,84,88,0.6);
    --nav-blur: rgba(20,20,22,0.85);
    --tabbar-blur: rgba(20,20,22,0.88);
    --switch-off: #39393d;
  }
  
  *{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  html,body{
    margin:0; padding:0; height:100%;
    background:#000;
    font-family:-apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, sans-serif;
    overflow:hidden;
  }
  #phone{
    max-width:430px; margin:0 auto; height:100vh; height:100dvh;
    background:var(--bg); position:relative; overflow:hidden;
    display:flex; flex-direction:column;
  }

  .stack{ position:relative; flex:1; overflow:hidden; }
  .screen{
    position:absolute; inset:0;
    display:flex; flex-direction:column;
    background:var(--bg);
    transition:transform .32s cubic-bezier(.32,.72,0,1), filter .32s;
    will-change:transform;
  }
  #chatlist-screen{ z-index:1; }
  #settings-screen{ z-index:1; transform:translateX(100%); }
  #chat-screen{ z-index:3; transform:translateX(100%); }
  #newchat-screen{ z-index:2; transform:translateX(100%); }
  #phone.open-chat #chat-screen{ transform:translateX(0); }
  #phone.open-chat #chatlist-screen{ filter:brightness(0.85); }
  #phone.tab-settings #settings-screen{ transform:translateX(0); }
  #phone.tab-settings #chatlist-screen{ transform:translateX(-100%); }
  #phone.open-newchat #newchat-screen{ transform:translateX(0); }
  #phone.open-newchat #chatlist-screen{ filter:brightness(0.85); }

  .navbar{
    flex-shrink:0;
    padding-top:calc(env(safe-area-inset-top,20px) + 4px);
    background:var(--nav-blur);
    backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
    border-bottom:0.5px solid var(--sep);
    position:relative; z-index:5;
  }
  .navbar-row{ display:flex; align-items:center; justify-content:space-between; padding:6px 16px 8px; }
  .nav-title-lg{ font-size:34px; font-weight:800; letter-spacing:-0.4px; padding:2px 16px 10px; color:var(--text); }
  .edit-link, .compose-btn{ color:var(--blue); font-size:17px; font-weight:400; background:none; border:none; padding:6px 4px; cursor:pointer; }
  .compose-btn{ font-size:24px; line-height:1; padding:4px 6px; }
  .edit-link.active{ font-weight:600; }

  .search-wrap{ padding:0 16px 8px; }
  .search-bar{
    background:rgba(118,118,128,0.12); border-radius:10px; padding:8px 10px;
    display:flex; align-items:center; gap:6px; color:var(--sub); font-size:17px;
  }
  .search-bar input{
    border:none; outline:none; background:transparent; font-size:17px; color:var(--text);
    flex:1; font-family:inherit;
  }
  .search-bar input::placeholder{ color:var(--sub); }

  .list{ flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch; }
  .chat-row{
    display:flex; align-items:center; gap:10px; padding:8px 16px;
    cursor:pointer; background:var(--bg); position:relative; transition:background .1s;
  }
  .chat-row:active{ background:rgba(120,120,128,0.08); }
  .chat-row::after{
    content:""; position:absolute; left:74px; right:0; bottom:0; height:0.5px; background:var(--sep);
  }
  .del-circle{
    width:22px; height:22px; border-radius:50%; background:var(--danger); color:#fff; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700;
    transform:scale(0); transition:transform .2s;
  }
  #phone.editing .del-circle{ transform:scale(1); }
  .avatar{
    width:54px; height:54px; border-radius:50%; display:flex; align-items:center; justify-content:center;
    color:#fff; font-size:22px; font-weight:600; flex-shrink:0; position:relative;
  }
  .avatar .online-dot{
    position:absolute; right:0; bottom:0; width:14px; height:14px; border-radius:50%;
    background:var(--success); border:2.5px solid var(--bg);
  }
  .chat-info{ flex:1; min-width:0; padding:8px 0; }
  .chat-top{ display:flex; justify-content:space-between; align-items:baseline; }
  .chat-name{ font-size:17px; font-weight:600; color:var(--text); display:flex; align-items:center; gap:4px; }
  .chat-time{ font-size:15px; color:var(--sub); flex-shrink:0; }
  .chat-bottom{ display:flex; justify-content:space-between; align-items:center; margin-top:2px; }
  .chat-msg{ font-size:15px; color:var(--sub); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:230px; }
  .badge{ background:var(--blue); color:#fff; font-size:13px; font-weight:600; min-width:20px; height:20px; border-radius:10px;
    display:flex; align-items:center; justify-content:center; padding:0 6px; flex-shrink:0; }
  .empty-hint{ text-align:center; color:var(--sub); font-size:15px; padding:40px 20px; }

  .tabbar{
    flex-shrink:0; display:flex; background:var(--tabbar-blur);
    backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px);
    border-top:0.5px solid var(--sep);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  .tab-btn{
    flex:1; display:flex; flex-direction:column; align-items:center; gap:2px;
    padding:6px 0 4px; background:none; border:none; color:var(--sub); font-size:10px; font-weight:500;
    cursor:pointer;
  }
  .tab-btn.active{ color:var(--blue); }
  .tab-btn svg{ width:26px; height:26px; }

  .settings-group{ margin-bottom:24px; }
  .settings-label{ font-size:13px; color:var(--sub); padding:0 16px 6px; text-transform:uppercase; letter-spacing:0.3px; }
  .settings-card{ background:var(--card); border-top:0.5px solid var(--sep); border-bottom:0.5px solid var(--sep); }
  .settings-item{
    display:flex; align-items:center; gap:12px; padding:11px 16px; min-height:24px; position:relative;
    cursor:pointer;
  }
  .settings-item + .settings-item::before{
    content:""; position:absolute; left:16px; right:0; top:0; height:0.5px; background:var(--sep);
  }
  .settings-icon{
    width:29px; height:29px; border-radius:8px; display:flex; align-items:center; justify-content:center;
    color:#fff; flex-shrink:0;
  }
  .settings-text{ flex:1; font-size:17px; color:var(--text); }
  .settings-value{ font-size:17px; color:var(--sub); margin-right:8px; }
  .chevron{ color:#c7c7cc; }

  .switch{ width:51px; height:31px; border-radius:16px; background:var(--switch-off); position:relative; flex-shrink:0; transition:background .2s; cursor:pointer; }
  .switch.on{ background:var(--success); }
  .switch::after{ content:""; position:absolute; width:27px; height:27px; border-radius:50%; background:#fff; top:2px; left:2px;
    box-shadow:0 3px 8px rgba(0,0,0,0.2); transition:transform .2s; }
  .switch.on::after{ transform:translateX(20px); }

  .color-row{ display:flex; gap:14px; padding:14px 16px; }
  .color-swatch{ width:34px; height:34px; border-radius:50%; flex-shrink:0; display:flex; align-items:center; justify-content:center; cursor:pointer; border:2px solid transparent; }
  .color-swatch.selected{ border-color:var(--blue); }
  .color-swatch svg{ width:16px; height:16px; color:#fff; opacity:0; }
  .color-swatch.selected svg{ opacity:1; }

  .profile-card{
    background:var(--card); margin:0 0 24px; padding:16px; display:flex; align-items:center; gap:14px;
    border-top:0.5px solid var(--sep); border-bottom:0.5px solid var(--sep);
  }
  .profile-avatar{
    width:64px; height:64px; border-radius:50%; background:linear-gradient(135deg,#7c7ce0,#5b5be0);
    display:flex; align-items:center; justify-content:center; color:#fff; font-size:26px; font-weight:600; flex-shrink:0;
  }
  .profile-name{ font-size:19px; font-weight:600; color:var(--text); }
  .profile-sub{ font-size:14px; color:var(--blue); margin-top:2px; }
  .profile-status{ font-size:13px; color:var(--sub); margin-top:2px; }

  .chat-navbar-row{ display:flex; align-items:center; gap:2px; padding:4px 8px 8px; }
  .back-btn{ display:flex; align-items:center; color:var(--blue); font-size:17px; background:none; border:none; gap:2px; padding:6px 2px; flex-shrink:0; cursor:pointer; }
  .chat-header-center{ flex:1; display:flex; flex-direction:column; align-items:center; cursor:pointer; }
  .chat-avatar-sm{ width:32px; height:32px; border-radius:50%; margin-bottom:1px; display:flex; align-items:center; justify-content:center; color:#fff; font-weight:600; font-size:13px; }
  .chat-header-name{ font-size:14px; font-weight:600; color:var(--text); }
  .chat-header-status{ font-size:12px; color:var(--sub); }
  .call-btn{ color:var(--blue); font-size:22px; background:none; border:none; padding:6px 10px; flex-shrink:0; cursor:pointer; }

  .messages{
    flex:1; overflow-y:auto; -webkit-overflow-scrolling:touch; padding:10px 10px 14px;
    display:flex; flex-direction:column; gap:2px;
    background: radial-gradient(circle at 20% 10%, rgba(0,122,255,0.04), transparent 40%), radial-gradient(circle at 80% 90%, rgba(0,122,255,0.05), transparent 40%), var(--bg);
  }
  .date-pill{ align-self:center; background:rgba(120,120,128,0.16); color:var(--sub); font-size:12px; font-weight:600; padding:4px 10px; border-radius:10px; margin:8px 0; }
  .bubble-row{ display:flex; max-width:100%; }
  .bubble-row.in{ justify-content:flex-start; }
  .bubble-row.out{ justify-content:flex-end; }
  .bubble{ max-width:78%; padding:7px 9px 6px 11px; border-radius:18px; font-size:16px; line-height:1.28; position:relative; margin:1.5px 0; word-wrap:break-word; }
  .bubble.in{ background:var(--gray-bubble); color:var(--text); border-bottom-left-radius:5px; box-shadow:0 1px 0 rgba(0,0,0,0.03); }
  .bubble.out{ background:linear-gradient(135deg,var(--blue-grad-a),var(--blue-grad-b)); color:#fff; border-bottom-right-radius:5px; }
  .bubble .meta{ display:inline-flex; align-items:center; gap:3px; float:right; margin-left:8px; margin-top:4px; font-size:11px; opacity:0.65; transform:translateY(3px); }
  .bubble.in .meta{ color:var(--sub); }
  .bubble.out .meta{ color:rgba(255,255,255,0.85); }
  .bubble .file-attach{
    display:flex; align-items:center; gap:8px; padding:4px 8px;
    background:rgba(0,0,0,0.06); border-radius:8px; margin-top:2px;
  }
  .bubble.out .file-attach{ background:rgba(255,255,255,0.15); }
  .bubble .file-attach .file-icon{ font-size:20px; }
  .bubble .file-attach .file-name{ font-size:13px; opacity:0.8; }

  .input-bar{ flex-shrink:0; display:flex; align-items:flex-end; gap:8px; padding:6px 8px calc(env(safe-area-inset-bottom,6px) + 6px);
    background:var(--nav-blur); backdrop-filter:blur(20px); -webkit-backdrop-filter:blur(20px); border-top:0.5px solid var(--sep); position:relative; }
  .icon-btn{ width:32px; height:32px; flex-shrink:0; border:none; background:none; color:var(--blue); display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:20px; }
  .input-pill{ flex:1; background:var(--card); border-radius:18px; border:0.5px solid var(--sep); padding:6px 12px; display:flex; align-items:flex-end; min-height:22px; }
  .input-pill textarea{ flex:1; border:none; outline:none; resize:none; font-size:16px; line-height:20px; max-height:100px; background:transparent; font-family:inherit; color:var(--text); }
  .send-btn{ width:32px; height:32px; border-radius:50%; border:none; flex-shrink:0; background:var(--blue); color:#fff; display:flex; align-items:center; justify-content:center; transform:scale(0); transition:transform .18s cubic-bezier(.34,1.56,.64,1); cursor:pointer; }
  .send-btn.show{ transform:scale(1); }

  .toast{
    position:absolute; left:50%; bottom:90px; transform:translateX(-50%) translateY(20px); z-index:30;
    background:rgba(40,40,42,0.92); color:#fff; padding:10px 18px; border-radius:12px; font-size:14px;
    opacity:0; transition:opacity .25s, transform .25s; pointer-events:none; white-space:nowrap;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

  .call-overlay{
    position:absolute; inset:0; z-index:25; background:linear-gradient(160deg,#2c2c2e,#1c1c1e);
    display:flex; flex-direction:column; align-items:center; justify-content:space-between;
    padding:60px 0 50px; opacity:0; pointer-events:none; transition:opacity .25s;
  }
  .call-overlay.show{ opacity:1; pointer-events:auto; }
  .call-avatar{ width:120px; height:120px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:44px; font-weight:600; }
  .call-name{ color:#fff; font-size:26px; font-weight:600; margin-top:16px; }
  .call-status{ color:rgba(255,255,255,0.6); font-size:16px; margin-top:6px; }
  .call-end{ width:64px; height:64px; border-radius:50%; background:var(--danger); display:flex; align-items:center; justify-content:center; border:none; cursor:pointer; }

  .auth-overlay{
    position:absolute; inset:0; z-index:50;
    background:var(--bg); display:flex; flex-direction:column;
    justify-content:center; padding:40px 30px;
    transition:opacity .3s;
  }
  .auth-overlay.hidden{ opacity:0; pointer-events:none; }
  .auth-overlay h2{ font-size:32px; font-weight:800; color:var(--text); margin-bottom:10px; }
  .auth-overlay .sub{ color:var(--sub); font-size:16px; margin-bottom:30px; }
  .auth-overlay input{
    padding:14px 16px; border-radius:12px; border:1px solid var(--sep);
    font-size:17px; margin-bottom:14px; background:var(--card); color:var(--text);
    outline:none; transition:border .2s; font-family:inherit;
  }
  .auth-overlay input:focus{ border-color:var(--blue); }
  .auth-overlay input.error{ border-color:var(--danger); }
  .auth-overlay .auth-btn{
    padding:14px; border-radius:12px; border:none;
    background:var(--blue); color:#fff; font-size:18px; font-weight:600;
    cursor:pointer; transition:background .2s;
  }
  .auth-overlay .auth-btn:active{ filter:brightness(0.9); }
  .auth-overlay .auth-toggle{
    margin-top:16px; text-align:center; color:var(--blue); cursor:pointer; font-weight:500;
  }
  .auth-overlay .auth-error{ 
    color:var(--danger); font-size:14px; margin-bottom:12px; text-align:center; 
    min-height:20px; background:rgba(255,59,48,0.08); padding:8px 12px; 
    border-radius:8px; display:none;
  }
  .auth-overlay .auth-error.show{ display:block; }

  .newchat-search{
    padding:12px 16px;
    background:var(--bg);
  }
  .newchat-search input{
    width:100%; padding:12px 16px; border-radius:12px;
    border:1px solid var(--sep); font-size:17px;
    background:var(--card); color:var(--text);
    outline:none; transition:border .2s;
  }
  .newchat-search input:focus{ border-color:var(--blue); }
  .user-row{
    display:flex; align-items:center; gap:12px; padding:12px 16px;
    cursor:pointer; transition:background .15s;
    border-bottom:0.5px solid var(--sep);
  }
  .user-row:active{ background:rgba(120,120,128,0.08); }
  .user-avatar{
    width:44px; height:44px; border-radius:50%; display:flex;
    align-items:center; justify-content:center;
    color:#fff; font-size:18px; font-weight:600; flex-shrink:0;
  }
  .user-info{ flex:1; }
  .user-name{ font-size:17px; font-weight:600; color:var(--text); }
  .user-status{ font-size:14px; color:var(--sub); }
  .user-online{ color:var(--success); }
  .user-offline{ color:var(--sub); }

  .modal{
    position:absolute; inset:0; z-index:40; background:rgba(0,0,0,0.5);
    display:flex; align-items:center; justify-content:center;
    opacity:0; pointer-events:none; transition:opacity .25s;
  }
  .modal.show{ opacity:1; pointer-events:auto; }
  .modal-content{
    background:var(--card); border-radius:16px; padding:24px;
    width:90%; max-width:340px;
  }
  .modal-title{ font-size:20px; font-weight:600; color:var(--text); margin-bottom:16px; }
  .modal-input{ width:100%; padding:12px 16px; border-radius:12px; border:1px solid var(--sep); font-size:17px; background:var(--bg); color:var(--text); outline:none; margin-bottom:16px; }
  .modal-input:focus{ border-color:var(--blue); }
  .modal-actions{ display:flex; gap:12px; justify-content:flex-end; }
  .modal-btn{ padding:10px 20px; border-radius:12px; border:none; font-size:16px; font-weight:600; cursor:pointer; }
  .modal-btn.cancel{ background:var(--bg); color:var(--text); }
  .modal-btn.confirm{ background:var(--blue); color:#fff; }

  .sheet-backdrop{
    position:absolute; inset:0; background:rgba(0,0,0,0.4); z-index:20;
    opacity:0; pointer-events:none; transition:opacity .2s;
  }
  .sheet-backdrop.show{ opacity:1; pointer-events:auto; }
  .action-sheet{
    position:absolute; left:8px; right:8px; bottom:8px; z-index:21;
    transform:translateY(120%); transition:transform .28s cubic-bezier(.32,.72,0,1);
  }
  .sheet-backdrop.show .action-sheet{ transform:translateY(0); }
  .sheet-group{ background:var(--card); border-radius:14px; overflow:hidden; margin-bottom:8px; }
  .sheet-btn{ width:100%; padding:16px; font-size:20px; text-align:center; background:none; border:none; color:var(--blue); position:relative; cursor:pointer; }
  .sheet-btn + .sheet-btn::before{ content:""; position:absolute; left:0; right:0; top:0; height:0.5px; background:var(--sep); }
  .sheet-btn.danger{ color:var(--danger); }
  .sheet-btn.cancel{ font-weight:600; }

  .hidden-input { display:none; }
  ::-webkit-scrollbar{ display:none; }
</style>
</head>
<body>

<div id="phone">
  <div class="auth-overlay" id="authOverlay">
    <h2>Messenger</h2>
    <div class="sub">Sign in to continue</div>
    <div class="auth-error" id="authError"></div>
    <input type="email" id="emailInput" placeholder="Email" autocomplete="email">
    <input type="text" id="nameInput" placeholder="Your name (unique)" autocomplete="off">
    <input type="password" id="passwordInput" placeholder="Password (min 6 chars)" autocomplete="current-password">
    <button class="auth-btn" id="authBtn">Sign In</button>
    <div class="auth-toggle" id="authToggle">Don't have an account? Sign Up</div>
  </div>

  <div class="stack">
    <div id="chatlist-screen" class="screen">
      <div class="navbar">
        <div class="navbar-row">
          <button class="edit-link" id="editLink" onclick="toggleEdit()">Edit</button>
          <button class="compose-btn" onclick="openNewChat()">+</button>
        </div>
        <div class="nav-title-lg">Chats</div>
        <div class="search-wrap">
          <div class="search-bar">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" placeholder="Search" id="searchInput" oninput="filterChats(this.value)">
          </div>
        </div>
      </div>
      <div class="list" id="chatListEl"></div>
    </div>

    <div id="newchat-screen" class="screen">
      <div class="navbar">
        <div class="navbar-row">
          <button class="edit-link" onclick="closeNewChat()" style="font-size:28px; line-height:1; padding:0 4px;">‹</button>
          <span style="font-size:20px; font-weight:600; color:var(--text);">New Chat</span>
          <div style="width:40px;"></div>
        </div>
      </div>
      <div class="newchat-search">
        <input type="text" id="userSearchInput" placeholder="Search users..." oninput="searchUsers(this.value)">
      </div>
      <div class="list" id="usersListEl">
        <div class="empty-hint">Type name to search</div>
      </div>
    </div>

    <div id="settings-screen" class="screen">
      <div class="navbar">
        <div class="nav-title-lg">Settings</div>
      </div>
      <div class="list" style="padding:8px 0;">
        <div class="profile-card">
          <div class="profile-avatar" id="profileAvatar">U</div>
          <div>
            <div class="profile-name" id="profileName">User</div>
            <div class="profile-sub" id="profileEmail">email@example.com</div>
            <div class="profile-status" id="profileStatus">Online</div>
          </div>
        </div>

        <div class="settings-group">
          <div class="settings-label">Account</div>
          <div class="settings-card">
            <div class="settings-item" onclick="showEditNameModal()">
              <div class="settings-icon" style="background:#007aff;">
