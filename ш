<script>
const firebaseConfig = {
  apiKey: "AIzaSyDv2gwofhSO5kdqlzVeK0-VeqVNZmZBvg4",
  authDomain: "messenger-83b8b.firebaseapp.com",
  projectId: "messenger-83b8b",
  storageBucket: "messenger-83b8b.firebasestorage.app",
  messagingSenderId: "873898812644",
  appId: "1:873898812644:web:75c73483b5120e55b478f1"
};

firebase.initializeApp(firebaseConfig);
const auth = firebase.auth();
const db = firebase.firestore();
const storage = firebase.storage();

let currentUser = null;
let currentChatId = null;
let currentChatPartner = null;
let editing = false;
let allUsers = {};
let unsubscribeChat = null;
let unsubscribeChats = null;
let isLoginMode = true;

const authOverlay = document.getElementById('authOverlay');
const emailInput = document.getElementById('emailInput');
const nameInput = document.getElementById('nameInput');
const passwordInput = document.getElementById('passwordInput');
const authError = document.getElementById('authError');
const authBtn = document.getElementById('authBtn');
const authToggle = document.getElementById('authToggle');
const listEl = document.getElementById('chatListEl');
const messagesEl = document.getElementById('messagesEl');
const usersListEl = document.getElementById('usersListEl');

nameInput.style.display = 'none';

function getErrorMessage(code) {
  const errors = {
    'auth/invalid-email': 'Invalid email format',
    'auth/user-not-found': 'User not found. Check email or sign up',
    'auth/wrong-password': 'Incorrect password. Try again',
    'auth/email-already-in-use': 'Email already in use. Sign in instead',
    'auth/weak-password': 'Password too weak. Minimum 6 characters',
    'auth/too-many-requests': 'Too many attempts. Wait a moment',
    'auth/network-request-failed': 'Network error. Check connection',
    'permission-denied': 'Access denied. Check Firebase rules',
    'default': 'An error occurred. Please try again'
  };
  return errors[code] || errors.default;
}

function showAuthError(msg) {
  authError.textContent = msg;
  authError.classList.add('show');
  setTimeout(() => authError.classList.remove('show'), 5000);
}

authBtn.addEventListener('click', handleAuth);
authToggle.addEventListener('click', () => {
  isLoginMode = !isLoginMode;
  authToggle.textContent = isLoginMode ? "Don't have an account? Sign Up" : "Already have an account? Sign In";
  authBtn.textContent = isLoginMode ? 'Sign In' : 'Sign Up';
  nameInput.style.display = isLoginMode ? 'none' : 'block';
  authError.classList.remove('show');
});

async function handleAuth() {
  const email = emailInput.value.trim();
  const pass = passwordInput.value.trim();
  const name = nameInput.value.trim();
  
  if (!email || !pass || (!isLoginMode && !name)) {
    showAuthError('Please fill in all fields');
    return;
  }
  
  if (pass.length < 6 && !isLoginMode) {
    showAuthError('Password must be at least 6 characters');
    return;
  }

  authBtn.textContent = 'Loading...';
  authBtn.disabled = true;

  try {
    if (isLoginMode) {
      await auth.signInWithEmailAndPassword(email, pass);
    } else {
      const nameCheck = await db.collection('users').where('name', '==', name).get();
      if (!nameCheck.empty) {
        showAuthError('This name is already taken. Please choose another.');
        authBtn.textContent = 'Sign Up';
        authBtn.disabled = false;
        return;
      }
      
      const cred = await auth.createUserWithEmailAndPassword(email, pass);
      await db.collection('users').doc(cred.user.uid).set({
        name: name,
        online: true,
        lastSeen: firebase.firestore.FieldValue.serverTimestamp()
      });
    }
  } catch (e) {
    showAuthError(getErrorMessage(e.code));
  } finally {
    authBtn.textContent = isLoginMode ? 'Sign In' : 'Sign Up';
    authBtn.disabled = false;
  }
}

auth.onAuthStateChanged(async user => {
  if (user) {
    currentUser = user;
    authOverlay.classList.add('hidden');
    updateProfile();
    
    try {
      await db.collection('users').doc(user.uid).set({
        online: true,
        lastSeen: firebase.firestore.FieldValue.serverTimestamp()
      }, { merge: true });
    } catch(e) {}
    
    listenUsers();
    renderChats();
  } else {
    currentUser = null;
    authOverlay.classList.remove('hidden');
    if (unsubscribeChat) { unsubscribeChat(); unsubscribeChat = null; }
    if (unsubscribeChats) { unsubscribeChats(); unsubscribeChats = null; }
  }
});

function updateProfile() {
  if (!currentUser) return;
  db.collection('users').doc(currentUser.uid).get().then(doc => {
    const data = doc.data();
    const name = data?.name || currentUser.email.split('@')[0];
    document.getElementById('profileName').textContent = name;
    document.getElementById('profileEmail').textContent = currentUser.email;
    document.getElementById('profileAvatar').textContent = name[0].toUpperCase();
  });
}

function listenUsers() {
  db.collection('users').onSnapshot(snapshot => {
    snapshot.forEach(doc => {
      const data = doc.data();
      allUsers[doc.id] = {
        name: data.name || 'Unknown',
        online: data.online || false
      };
    });
    if (currentUser) renderChats();
  });
}

function getOtherUid(chatDocId, myUid) {
  const parts = chatDocId.split('_');
  return parts.length === 2 ? (parts[0] === myUid ? parts[1] : parts[0]) : null;
}

function getChatId(uid1, uid2) {
  return uid1 < uid2 ? `${uid1}_${uid2}` : `${uid2}_${uid1}`;
}

// ==================== ОСНОВНОЕ ИСПРАВЛЕНИЕ — БЕЗ ИНДЕКСА ====================
function renderChats() {
  if (!currentUser) return;
  const myUid = currentUser.uid;
  listEl.innerHTML = '<div class="empty-hint">Loading...</div>';

  if (unsubscribeChats) unsubscribeChats();

  try {
    // УБИРАЕМ orderBy — НЕ НУЖЕН ИНДЕКС
    unsubscribeChats = db.collection('chats')
      .where('participants', 'array-contains', myUid)
      .onSnapshot(snapshot => {
        if (snapshot.empty) {
          listEl.innerHTML = '<div class="empty-hint">No chats. Press + to start</div>';
          return;
        }

        let items = [];
        snapshot.forEach(doc => {
          const data = doc.data();
          const otherId = getOtherUid(doc.id, myUid);
          if (!otherId) return;
          const partner = allUsers[otherId] || { name: 'Unknown', online: false };
          const lastMsg = data.lastMessage || 'Start chatting';
          const time = data.lastUpdated ? new Date(data.lastUpdated.seconds * 1000) : new Date();
          items.push({
            id: doc.id,
            otherId,
            partnerName: partner.name || 'Unknown',
            online: partner.online || false,
            lastMessage: lastMsg,
            time: time
          });
        });

        // СОРТИРУЕМ ВРУЧНУЮ (без индекса)
        items.sort((a, b) => b.time - a.time);
        listEl.innerHTML = '';

        items.forEach(item => {
          const colors = ['#7c7ce0', '#34c759', '#ff2d55', '#ff9500', '#af52de'];
          const color = colors[Math.floor(Math.random() * colors.length)];
          
          const row = document.createElement('div');
          row.className = 'chat-row';
          row.onclick = () => openChat(item.id, item.otherId, item.partnerName);
          row.innerHTML = `
            <div class="del-circle">-</div>
            <div class="avatar" style="background:${color};">
              ${item.partnerName[0].toUpperCase()}
              ${item.online ? '<span class="online-dot"></span>' : ''}
            </div>
            <div class="chat-info">
              <div class="chat-top">
                <span class="chat-name">${item.partnerName}</span>
                <span class="chat-time">${item.time.toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'})}</span>
              </div>
              <div class="chat-bottom">
                <span class="chat-msg">${item.lastMessage}</span>
              </div>
            </div>
          `;
          listEl.appendChild(row);
        });
      }, error => {
        listEl.innerHTML = `<div class="empty-hint">Error: ${getErrorMessage(error.code)}</div>`;
        console.error('Chats error:', error);
      });
  } catch (error) {
    listEl.innerHTML = `<div class="empty-hint">Error: ${getErrorMessage(error.code)}</div>`;
  }
}

function searchUsers(query) {
  if (!currentUser) return;
  const q = query.toLowerCase().trim();
  
  if (!q) {
    usersListEl.innerHTML = '<div class="empty-hint">Type name to search</div>';
    return;
  }

  db.collection('users').get().then(snapshot => {
    const results = [];
    snapshot.forEach(doc => {
      const data = doc.data();
      if (doc.id !== currentUser.uid) {
        const name = data.name || 'Unknown';
        if (name.toLowerCase().includes(q)) {
          results.push({ uid: doc.id, name, online: data.online || false });
        }
      }
    });

    if (results.length === 0) {
      usersListEl.innerHTML = '<div class="empty-hint">No users found</div>';
      return;
    }

    usersListEl.innerHTML = '';
    const colors = ['#7c7ce0', '#34c759', '#ff2d55', '#ff9500', '#af52de'];
    results.forEach(user => {
      const color = colors[Math.floor(Math.random() * colors.length)];
      const row = document.createElement('div');
      row.className = 'user-row';
      row.onclick = () => startChatWithUser(user.uid, user.name);
      row.innerHTML = `
        <div class="user-avatar" style="background:${color};">${user.name[0].toUpperCase()}</div>
        <div class="user-info">
          <div class="user-name">${user.name}</div>
          <div class="user-status ${user.online ? 'user-online' : 'user-offline'}">${user.online ? 'online' : 'offline'}</div>
        </div>
      `;
      usersListEl.appendChild(row);
    });
  });
}

async function startChatWithUser(partnerUid, partnerName) {
  if (!currentUser || partnerUid === currentUser.uid) return;
  const chatId = getChatId(currentUser.uid, partnerUid);
  const chatRef = db.collection('chats').doc(chatId);
  
  try {
    const doc = await chatRef.get();
    if (!doc.exists) {
      await chatRef.set({
        participants: [currentUser.uid, partnerUid],
        lastMessage: 'Chat created',
        lastUpdated: firebase.firestore.FieldValue.serverTimestamp()
      });
    }
    closeNewChat();
    openChat(chatId, partnerUid, partnerName);
  } catch (e) {
    toast('Error: ' + getErrorMessage(e.code));
  }
}

function openNewChat() {
  if (!currentUser) { toast('Please sign in'); return; }
  document.getElementById('phone').classList.add('open-newchat');
  document.getElementById('userSearchInput').value = '';
  usersListEl.innerHTML = '<div class="empty-hint">Type name to search</div>';
}

function closeNewChat() {
  document.getElementById('phone').classList.remove('open-newchat');
}

function openChat(chatId, partnerUid, partnerName) {
  if (!currentUser) return;
  currentChatId = chatId;
  currentChatPartner = { uid: partnerUid, name: partnerName };
  
  const colors = ['#7c7ce0', '#34c759', '#ff2d55', '#ff9500', '#af52de'];
  const color = colors[Math.floor(Math.random() * colors.length)];
  
  document.getElementById('chatAvatarSm').textContent = partnerName[0].toUpperCase();
  document.getElementById('chatAvatarSm').style.background = color;
  document.getElementById('chatHeaderName').textContent = partnerName;
  document.getElementById('chatHeaderStatus').textContent = allUsers[partnerUid]?.online ? 'online' : 'offline';
  document.getElementById('callAvatar').textContent = partnerName[0].toUpperCase();
  document.getElementById('callAvatar').style.background = color;
  document.getElementById('callName').textContent = partnerName;
  
  document.getElementById('phone').classList.add('open-chat');
  loadMessages(chatId);
}

function closeChat() {
  document.getElementById('phone').classList.remove('open-chat');
  if (unsubscribeChat) { unsubscribeChat(); unsubscribeChat = null; }
}

function loadMessages(chatId) {
  if (unsubscribeChat) { unsubscribeChat(); unsubscribeChat = null; }
  messagesEl.innerHTML = '<div class="empty-hint">Loading...</div>';

  const myUid = currentUser.uid;
  try {
    unsubscribeChat = db.collection('chats')
      .doc(chatId)
      .collection('messages')
      .orderBy('timestamp', 'asc')
      .onSnapshot(snapshot => {
        messagesEl.innerHTML = '<div class="date-pill">Today</div>';
        if (snapshot.empty) {
          messagesEl.innerHTML = '<div class="empty-hint">Send the first message</div>';
          return;
        }
        snapshot.forEach(doc => {
          const data = doc.data();
          const isOut = data.senderId === myUid;
          const row = document.createElement('div');
          row.className = 'bubble-row ' + (isOut ? 'out' : 'in');
          const bubble = document.createElement('div');
          bubble.className = 'bubble ' + (isOut ? 'out' : 'in');
          
          let displayText = data.text || '';
          if (data.type === 'photo') displayText = '[Photo]';
          else if (data.type === 'file') displayText = '[File: ' + (data.filename || 'file') + ']';
          else if (data.type === 'video') displayText = '[Video]';
          else if (data.type === 'voice') displayText = '[Voice]';
          
          const time = data.timestamp ? new Date(data.timestamp.seconds * 1000) : new Date();
          bubble.innerHTML = displayText + `<span class="meta">${time.toLocaleTimeString('ru-RU', {hour:'2-digit', minute:'2-digit'})}</span>`;
          
          if (data.url && (data.type === 'photo' || data.type === 'video')) {
            const media = document.createElement(data.type === 'video' ? 'video' : 'img');
            media.src = data.url;
            media.style.maxWidth = '200px';
            media.style.borderRadius = '8px';
            media.style.marginTop = '4px';
            if (data.type === 'video') {
              media.controls = true;
              media.style.maxHeight = '200px';
            }
            bubble.appendChild(media);
          }
          
          row.appendChild(bubble);
          messagesEl.appendChild(row);
        });
        messagesEl.scrollTop = messagesEl.scrollHeight;
      }, error => {
        messagesEl.innerHTML = `<div class="empty-hint">Error: ${getErrorMessage(error.code)}</div>`;
      });
  } catch (error) {
    messagesEl.innerHTML = `<div class="empty-hint">Error: ${getErrorMessage(error.code)}</div>`;
  }
}

async function sendMessage(text, type, file) {
  if (!currentUser || !currentChatId) { toast('Select a chat'); return; }
  
  try {
    const chatRef = db.collection('chats').doc(currentChatId);
    
    if (file) {
      const storageRef = storage.ref('chat_files/' + Date.now() + '_' + file.name);
      const snapshot = await storageRef.put(file);
      const url = await snapshot.ref.getDownloadURL();
      
      const msgRef = chatRef.collection('messages').doc();
      await msgRef.set({
        text: text || file.name,
        type: type,
        url: url,
        filename: file.name,
        senderId: currentUser.uid,
        timestamp: firebase.firestore.FieldValue.serverTimestamp()
      });
    } else {
      const msgRef = chatRef.collection('messages').doc();
      await msgRef.set({
        text: text,
        type: type || 'text',
        senderId: currentUser.uid,
        timestamp: firebase.firestore.FieldValue.serverTimestamp()
      });
    }
    
    await chatRef.update({
      lastMessage: text || (file ? file.name : ''),
      lastUpdated: firebase.firestore.FieldValue.serverTimestamp()
    });
  } catch (e) {
    toast('Error: ' + getErrorMessage(e.code));
  }
}

async function sendTextMessage() {
  const input = document.getElementById('msgInput');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  input.style.height = 'auto';
  document.getElementById('sendBtn').classList.remove('show');
  await sendMessage(text, 'text');
}

document.getElementById('sendBtn').addEventListener('click', sendTextMessage);
document.getElementById('msgInput').addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    e.preventDefault();
    sendTextMessage();
  }
});

function openAttachSheet() {
  document.getElementById('attachSheetBackdrop').classList.add('show');
}

function closeSheets(e) {
  if (e && e.target !== e.currentTarget) return;
  document.getElementById('attachSheetBackdrop').classList.remove('show');
}

function createFileInput(type) {
  const input = document.createElement('input');
  input.type = 'file';
  input.className = 'hidden-input';
  if (type === 'photo' || type === 'video') {
    input.accept = type === 'photo' ? 'image/*' : 'video/*';
  } else {
    input.accept = '*/*';
  }
  input.onchange = async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    document.getElementById('attachSheetBackdrop').classList.remove('show');
    await sendMessage(file.name, type, file);
    toast(type + ' sent');
    input.value = '';
  };
  document.body.appendChild(input);
  return input;
}

function sendAttachment(type) {
  document.getElementById('attachSheetBackdrop').classList.remove('show');
  
  if (type === 'voice') {
    toast('Recording voice...');
    setTimeout(async () => {
      await sendMessage('Voice message', 'voice');
      toast('Voice sent');
    }, 1500);
    return;
  }
  
  const input = createFileInput(type);
  input.click();
}

function toast(msg) {
  const t = document.getElementById('toastEl');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2500);
}
let toastTimer;

function filterChats(v) { renderChats(); }

function toggleEdit() {
  editing = !editing;
  document.getElementById('editLink').textContent = editing ? 'Done' : 'Edit';
  document.getElementById('editLink').classList.toggle('active', editing);
  document.getElementById('phone').classList.toggle('editing', editing);
}

function switchTab(tab) {
  document.getElementById('tabChats').classList.toggle('active', tab === 'chats');
  document.getElementById('tabSettings').classList.toggle('active', tab === 'settings');
  document.getElementById('phone').classList.toggle('tab-settings', tab === 'settings');
  if (tab === 'chats') closeNewChat();
}

function toggleDark() {
  const html = document.documentElement;
  const on = html.classList.toggle('dark');
  document.getElementById('darkSwitch').classList.toggle('on', on);
}

function toggleSwitch(el) {
  el.classList.toggle('on');
}

function onInputChange(el) {
  el.style.height = 'auto';
  el.style.height = Math.min(el.scrollHeight, 100) + 'px';
  document.getElementById('sendBtn').classList.toggle('show', el.value.trim().length > 0);
}

function startCall() {
  document.getElementById('callOverlay').classList.add('show');
  document.getElementById('callStatus').textContent = 'calling...';
}
function endCall() {
  document.getElementById('callOverlay').classList.remove('show');
}

function showEditNameModal() {
  document.getElementById('editNameModal').classList.add('show');
  document.getElementById('editNameInput').value = currentUser?.displayName || '';
}

function closeModal() {
  document.getElementById('editNameModal').classList.remove('show');
}

async function saveName() {
  const name = document.getElementById('editNameInput').value.trim();
  if (!name) { toast('Name cannot be empty'); return; }
  
  const nameCheck = await db.collection('users').where('name', '==', name).get();
  let taken = false;
  nameCheck.forEach(doc => {
    if (doc.id !== currentUser.uid) taken = true;
  });
  
  if (taken) {
    toast('This name is already taken');
    return;
  }
  
  try {
    await db.collection('users').doc(currentUser.uid).update({ name: name });
    updateProfile();
    closeModal();
    toast('Name updated');
  } catch (e) {
    toast('Error: ' + getErrorMessage(e.code));
  }
}

async function logout() {
  if (currentUser) {
    try { await db.collection('users').doc(currentUser.uid).update({ online: false }); } catch(e) {}
  }
  auth.signOut();
  toast('Signed out');
}

const accents = [
  {key:'', hex:'#007aff'},
  {key:'accent-green', hex:'#34c759'},
  {key:'accent-pink', hex:'#ff2d55'},
  {key:'accent-orange', hex:'#ff9500'},
  {key:'accent-purple', hex:'#af52de'}
];
const colorRow = document.getElementById('colorRow');
accents.forEach((a, i) => {
  const sw = document.createElement('div');
  sw.className = 'color-swatch' + (i === 0 ? ' selected' : '');
  sw.style.background = a.hex;
  sw.dataset.key = a.key;
  sw.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><path d="M4 12l5 5L20 6"/></svg>`;
  sw.onclick = () => {
    document.querySelectorAll('.color-swatch').forEach(s => s.classList.remove('selected'));
    sw.classList.add('selected');
    accents.forEach(ac => { if (ac.key) document.documentElement.classList.remove(ac.key); });
    if (a.key) document.documentElement.classList.add(a.key);
  };
  colorRow.appendChild(sw);
});

